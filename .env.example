# Nunca colocar credenciais, tokens ou perfil do WhatsApp no Git.
ALLOW_OTHER_PEOPLE=true
ALLOW_GROUPS=false
SEND_PROGRESS=false
REQUEST_DELAY_SECONDS=10
MAX_FILE_MB=45
MAX_DURATION_SECONDS=1200
DOWNLOAD_TIMEOUT_SECONDS=180
MAX_QUEUE=5
CHAT_COOLDOWN_SECONDS=30
MAX_LINK_AGE_HOURS=72
# Opcional fora do Docker: arquivo Netscape de sessao exclusivo do TikTok.
# TIKTOK_COOKIES_FILE=data/tiktok/cookies.txt
# ADMIN_TOKEN=senha-forte-definida-no-painel-da-hospedagem
# Docker define PYTHON_BIN, CHROME_PATH, AUTH_DATA_PATH, PORT e CHROME_NO_SANDBOX.
